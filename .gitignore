# --- 의존성 및 빌드 ---
# 프로젝트 루트나 서브 디렉토리의 node_modules 전체 제외
node_modules/
**/node_modules/

# Vite 빌드 결과물 및 임시 파일
dist/
dist-ssr/
*.local

# --- 로그 및 에러 ---
# npm, yarn, pnpm 로그 파일들
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- 환경 변수 (보안상 매우 중요) ---
# API 키나 로컬 설정이 담긴 파일들
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- 운영체제 및 시스템 ---
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
desktop.ini

# --- 에디터 및 툴 ---
# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# IntelliJ / WebStorm
.idea/
*.iws
*.iml
*.ipr

# --- 기타 ---
# Vite 캐시 폴더
.vite/
# 테스트 커버리지 결과물
coverage/